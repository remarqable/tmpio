# Inputs for `make deploy` (copy to config/deploy.env; that file is gitignored).
# doadmin connection URL to the DigitalOcean managed database, defaultdb.
DOADMIN_URL=postgresql://doadmin:<password>@<cluster-host>.db.ondigitalocean.com:25060/defaultdb?sslmode=require
# Password that gates /login and /auth/dev behind HTTP basic auth while Google
# sign-in is not configured. Username defaults to "admin" (BASICAUTH_USER).
BASICAUTH_PW=
BASICAUTH_USER=admin
# Server and origin
HOST=root@<server>
ORIGIN=https://<your-domain>
# Once a Google OAuth client exists (redirect https://tmp.io/auth/google/callback):
# set these, set APP_ENV=prod and DEV_LOGIN_BYPASS=0, then remove the basic_auth block from Caddy.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_ENV=staging
DEV_LOGIN_BYPASS=1
# 0 until the hosted service opens: first sign-ins are refused and the landing page collects the waitlist.
SIGNUPS_ENABLED=0
# Optional: AI-assisted filing on the server (see docs/SETUP.md).
ANTHROPIC_API_KEY=
AI_WORKSPACE_ID=
AI_MODEL=claude-haiku-4-5-20251001
