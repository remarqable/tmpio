APP_ENV=dev
PORT=8000
APP_ORIGIN=http://localhost:8000

# PostgreSQL: runtime role (RLS enforced) and owner role (migrations only)
DATABASE_URL=postgres://app_user:app@127.0.0.1:5433/tmp?sslmode=disable
DATABASE_OWNER_URL=postgres://app_owner:app@127.0.0.1:5433/tmp?sslmode=disable
TEST_DATABASE_URL=postgres://app_user:app@127.0.0.1:5433/tmp_test?sslmode=disable
TEST_DATABASE_OWNER_URL=postgres://app_owner:app@127.0.0.1:5433/tmp_test?sslmode=disable

# 32+ random characters. Signs shared-editor CSRF nonces and pagination cursors (sessions are stored server-side).
SESSION_SECRET=change-me-to-a-long-random-value

# Google OpenID Connect (leave empty to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8000/auth/google/callback

# Development-only sign-in bypass. Startup fails if this is set with APP_ENV=prod.
DEV_LOGIN_BYPASS=1

# Preregistered OAuth clients for MCP (JSON array). Claude and ChatGPT defaults are
# built in; add or override here. "public": true means PKCE-only (no secret).
# Quote the value: it contains spaces. Example (a local test client):
# OAUTH_CLIENTS_JSON='[{"id":"local-test","name":"Local test client","redirect_uris":["http://127.0.0.1:9876/cb"],"public":true}]'

# Operator metrics: when set, GET /metrics needs "Authorization: Bearer <token>"; otherwise loopback only.
METRICS_TOKEN=

# Your own front page. Unset, which is the default, means development shows the
# built-in sign-in page — the same thing every installation gets. Point it at a
# directory of static files to serve those to signed-out visitors instead.
# PUBLIC_SITE_DIR=
# PUBLIC_SITE_CSP=

# New-account creation. 0 refuses first sign-ins and shows the launch waitlist instead;
# existing accounts still sign in. Public repository URL shown on the landing page.
SIGNUPS_ENABLED=1
SOURCE_URL=https://github.com/remarqable/tmpio

# AI-assisted filing (optional). With a key, Quick add and the MCP tools tmp_organize /
# tmp_write path "auto" can ask a small model where a note belongs; without it a rule-based
# fallback files into a matching folder or /inbox. Each organization's owner must also turn
# it on in Site settings before any content is sent.
ANTHROPIC_API_KEY=
# Only for organization-level keys (not scoped to a workspace): the workspace to bill.
AI_WORKSPACE_ID=
AI_MODEL=claude-haiku-4-5-20251001
AI_MAX_CALLS_PER_HOUR=120

# Quotas (per tenant)
QUOTA_MAX_PAGES=1000
QUOTA_MAX_DIRECTORIES=100
QUOTA_MAX_PAGE_BYTES=262144
QUOTA_MAX_CONFIG_BYTES=32768
QUOTA_MAX_ASSET_BYTES=5242880
QUOTA_MAX_DOCUMENT_BYTES=20971520
QUOTA_MAX_FILE_BYTES=1048576
QUOTA_MAX_ASSET_PIXELS=20000000
QUOTA_MAX_CURRENT_ASSET_BYTES=104857600
QUOTA_MAX_RETAINED_BYTES=524288000
