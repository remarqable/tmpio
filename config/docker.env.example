# tmp, self-hosted with Docker. Copy to .env next to docker-compose.yml.
#
#   cp docker.env.example .env
#   docker compose up -d
#
# Generate the three secrets below with:  openssl rand -hex 32

# --- required -------------------------------------------------------------

# The public URL people reach this instance at. Must be https:// in production,
# and must match the address your reverse proxy serves.
APP_ORIGIN=https://tmp.example.com

# Signs session cookies and pagination cursors. At least 32 characters.
# Changing it signs everyone out.
SESSION_SECRET=

# The database passwords. They are only used between the two containers.
POSTGRES_PASSWORD=
APP_USER_PASSWORD=

# The owner account. On first boot this creates the account, its organization
# and its starting pages; after that, setting a new password here rotates it.
# Once the account exists you may remove OWNER_PASSWORD, but keep OWNER_EMAIL:
# it is what turns the password sign-in form on.
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=

# --- production -----------------------------------------------------------

# prod turns on Secure cookies, HSTS and release logging, and refuses a
# plaintext origin. Leave it as prod unless you are developing against this.
APP_ENV=prod

# Nobody but the owner can create an account on a self-hosted instance anyway,
# but this also hides the sign-up path entirely.
SIGNUPS_ENABLED=0

# --- optional -------------------------------------------------------------

# Sign in with Google as well as (or instead of) the password form. Redirect
# URI is APP_ORIGIN/auth/google/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AI-assisted filing. Even with a key it stays off until you turn it on in
# Site settings, and nothing is sent to a model while it is off.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-4-5-20251001

# GET /metrics needs this bearer token; without it, loopback clients only.
# METRICS_TOKEN=

# Your own front page. Files in ./web (mounted at /web) are served to visitors
# who are not signed in, before the built-in sign-in page. They run on this
# origin, so treat write access to that directory as you would deploy access to
# the application itself. PUBLIC_SITE_CSP replaces the Content-Security-Policy
# on those files only; unset keeps the application's strict policy, which
# blocks inline scripts and third-party origins.
# PUBLIC_SITE_CSP=default-src 'self'; script-src 'self' 'unsafe-inline'

# Which addresses may set X-Forwarded-For. The compose file already sets this
# to the Docker bridge range, which is where your reverse proxy appears from
# inside the container. Override only if your proxy runs somewhere else; the
# value "none" ignores the header entirely and uses the peer address.
# TRUSTED_PROXIES=172.16.0.0/12
